// ============================================================
// App.test.js — Suite de tests (Jest + @testing-library/react-native)
//
// Nota de compatibilidad: las versiones recientes de
// @testing-library/react-native hicieron `render()` asíncrono y
// recomiendan consultar el DOM vía el objeto global `screen` en vez
// de destructurar getByText/getByTestId del valor de retorno de
// render() (eso rompía con "getByText is not a function"). Por eso
// aquí siempre se hace `await render(<App />)` seguido de
// `screen.getByX(...)`.
//
// Cobertura exigida por la auditoría:
//  - Mocks de expo-camera, expo-image-manipulator y @supabase/supabase-js.
//  - Mock de fetch global: éxito, 403, 429, 500 y JSON malformado.
//  - Verificación de que los spinners de carga siempre se desmontan.
//
// Instalar antes de correr (ver SETUP.md):
//   npm install --save-dev jest jest-expo @testing-library/react-native react-test-renderer
//   npx jest
// ============================================================

import React from 'react';
import { Alert } from 'react-native';
import { render, screen, fireEvent, waitFor, act } from '@testing-library/react-native';

// ------------------------------------------------------------
// Mocks de módulos nativos/externos
// ------------------------------------------------------------

let mockPermissionState = { granted: true };
const mockRequestPermission = jest.fn(() => Promise.resolve(mockPermissionState));
const mockTakePictureAsync = jest.fn();

jest.mock('expo-camera', () => {
  const React = require('react');
  const { View } = require('react-native');
  return {
    useCameraPermissions: () => [mockPermissionState, mockRequestPermission],
    CameraView: React.forwardRef((props, ref) => {
      React.useImperativeHandle(ref, () => ({
        takePictureAsync: mockTakePictureAsync,
      }));
      // Simulamos que la cámara nativa está lista casi al instante,
      // igual que haría el evento real onCameraReady.
      React.useEffect(() => {
        props.onCameraReady && props.onCameraReady();
      }, []);
      return <View testID="camera-view">{props.children}</View>;
    }),
  };
});

jest.mock('expo-image-manipulator', () => ({
  manipulateAsync: jest.fn(() =>
    Promise.resolve({ uri: 'file://foto-redimensionada.jpg', base64: 'ZmFrZWJhc2U2NA==' })
  ),
  SaveFormat: { JPEG: 'jpeg' },
}));

jest.mock('expo-file-system', () => ({
  deleteAsync: jest.fn(() => Promise.resolve()),
}));

jest.mock('react-native-url-polyfill/auto', () => ({}));

// Mock encadenable de supabase-js: cada método devuelve `this` y el
// objeto final es "thenable" para poder hacer `await builder`.
function mockCrearSupabaseQueryMock(resolverCon) {
  const builder = {
    upsert: jest.fn(() => builder),
    select: jest.fn(() => builder),
    single: jest.fn(() => builder),
    insert: jest.fn(() => builder),
    eq: jest.fn(() => builder),
    limit: jest.fn(() => builder),
    abortSignal: jest.fn(() => builder),
    then: (resolve) => resolve(resolverCon),
  };
  return builder;
}

let mockPlantaUpsertResultado = { data: { id: 'planta-1' }, error: null };
let mockDiagnosticoInsertResultado = { error: null };

jest.mock('@supabase/supabase-js', () => ({
  createClient: () => ({
    from: (tabla) => {
      if (tabla === 'plantas') return mockCrearSupabaseQueryMock(mockPlantaUpsertResultado);
      if (tabla === 'diagnosticos') return mockCrearSupabaseQueryMock(mockDiagnosticoInsertResultado);
      throw new Error(`Tabla no mockeada: ${tabla}`);
    },
  }),
}));

// App.js se importa DESPUÉS de declarar los jest.mock (hoisting de Jest
// los sube automáticamente por encima de este import).
import App from './App';

// ------------------------------------------------------------
// Utilidades de test
// ------------------------------------------------------------

function respuestaGeminiOk(json) {
  return {
    ok: true,
    status: 200,
    json: () => Promise.resolve({ candidates: [{ content: { parts: [{ text: JSON.stringify(json) }] } }] }),
    text: () => Promise.resolve(JSON.stringify(json)),
  };
}

function respuestaGeminiError(status, cuerpo = 'error') {
  return { ok: false, status, text: () => Promise.resolve(cuerpo) };
}

async function dispararCaptura() {
  await act(async () => {
    fireEvent.press(screen.getByTestId('boton-capturar'));
  });
}

beforeEach(() => {
  jest.clearAllMocks();
  mockPermissionState = { granted: true };
  mockPlantaUpsertResultado = { data: { id: 'planta-1' }, error: null };
  mockDiagnosticoInsertResultado = { error: null };
  mockTakePictureAsync.mockResolvedValue({ uri: 'file://foto-original.jpg' });
  global.fetch = jest.fn();
  jest.spyOn(Alert, 'alert').mockImplementation(() => {});
});

// ------------------------------------------------------------
// Tests
// ------------------------------------------------------------

test('pantalla de permisos: pide permiso de cámara si no está concedido', async () => {
  mockPermissionState = { granted: false };
  await render(<App />);

  expect(screen.getByText(/necesita acceso a la cámara/i)).toBeTruthy();

  fireEvent.press(screen.getByText('Conceder permiso'));
  expect(mockRequestPermission).toHaveBeenCalled();
});

test('flujo feliz: captura, analiza y muestra el resultado; el spinner desaparece', async () => {
  global.fetch.mockResolvedValueOnce(
    respuestaGeminiOk({ estado: 'sana', problema: 'ninguno', tratamiento: 'sin acción' })
  );

  await render(<App />);
  await dispararCaptura();

  await waitFor(() => expect(mockTakePictureAsync).toHaveBeenCalled());
  await waitFor(() => expect(screen.getByText('sana')).toBeTruthy());

  // El spinner de "Analizando con Gemini…" no debe seguir presente.
  expect(screen.queryByText(/Analizando con Gemini/i)).toBeNull();
});

test('Gemini responde 429 (cuota agotada): mensaje específico y spinner apagado', async () => {
  global.fetch.mockResolvedValueOnce(respuestaGeminiError(429));

  await render(<App />);
  await dispararCaptura();

  await screen.findByText(/límite gratuito de peticiones/i);
  expect(screen.queryByText(/Analizando con Gemini/i)).toBeNull();
});

test('Gemini responde 500: mensaje de servicio no disponible', async () => {
  global.fetch.mockResolvedValueOnce(respuestaGeminiError(500));

  await render(<App />);
  await dispararCaptura();

  await screen.findByText(/no está disponible ahora mismo/i);
  expect(screen.queryByText(/Analizando con Gemini/i)).toBeNull();
});

test('Gemini responde 403 (auth): mensaje de API key inválida', async () => {
  global.fetch.mockResolvedValueOnce(respuestaGeminiError(403));

  await render(<App />);
  await dispararCaptura();

  await screen.findByText(/API key de Gemini no es válida/i);
});

test('Gemini devuelve JSON malformado: cae a un resultado de error legible, sin crashear', async () => {
  global.fetch.mockResolvedValueOnce({
    ok: true,
    status: 200,
    json: () =>
      Promise.resolve({
        candidates: [{ content: { parts: [{ text: '{"estado": "sana", "problema": ' /* truncado */ }] } }],
      }),
  });

  await render(<App />);
  await dispararCaptura();

  await screen.findByText('respuesta no interpretable');
  expect(screen.queryByText(/Analizando con Gemini/i)).toBeNull();
});

test('fallo de red (fetch rechaza): mensaje de sin conexión y spinner apagado', async () => {
  global.fetch.mockRejectedValueOnce(new Error('Network request failed'));

  await render(<App />);
  await dispararCaptura();

  await screen.findByText(/Sin conexión a internet/i);
  expect(screen.queryByText(/Analizando con Gemini/i)).toBeNull();
});

test('guardarEnSupabase: éxito hace upsert de planta + insert de diagnóstico y confirma', async () => {
  global.fetch.mockResolvedValueOnce(
    respuestaGeminiOk({ estado: 'sana', problema: 'ninguno', tratamiento: 'sin acción' })
  );

  await render(<App />);
  await dispararCaptura();
  await screen.findByText('sana');

  const botonGuardar = await screen.findByText('Guardar diagnóstico');
  await act(async () => {
    fireEvent.press(botonGuardar);
  });

  await waitFor(() => expect(Alert.alert).toHaveBeenCalledWith('Guardado', expect.any(String)));
});

test('guardarEnSupabase: violación de FK produce mensaje específico, no un crash', async () => {
  global.fetch.mockResolvedValueOnce(
    respuestaGeminiOk({ estado: 'sana', problema: 'ninguno', tratamiento: 'sin acción' })
  );
  mockDiagnosticoInsertResultado = { error: { code: '23503', message: 'foreign key violation' } };

  await render(<App />);
  await dispararCaptura();
  await screen.findByText('sana');

  const botonGuardar = await screen.findByText('Guardar diagnóstico');
  await act(async () => {
    fireEvent.press(botonGuardar);
  });

  await waitFor(() =>
    expect(Alert.alert).toHaveBeenCalledWith('Error al guardar', expect.stringMatching(/planta asociada/i))
  );
});
